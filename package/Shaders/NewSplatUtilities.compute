RWTexture2D<float4> _GSRenderTexture;
RWTexture2D<float> _GSDepthTexture;

[numthreads(BLOCK_X, BLOCK_Y, 1)]
void CSRenderViewData (uint3 global_id : SV_DispatchThreadID, uint3 group_id : SV_GroupID)
{
    float W = _VecScreenParams.x;
    float H = _VecScreenParams.y;
    uint horizontal_blocks = (uint)((W + BLOCK_X - 1) / BLOCK_X);
    
    if (global_id.x < W && global_id.y < H)
    {
        // 计算迭代次数
        uint2 range = _RO_ImageLeftRange[group_id.y * horizontal_blocks + group_id.x];
        
        int toDo = range.y - range.x;
        
        if (toDo > 100 * BLOCK_SIZE)
            return;
        
        // 累计透明度、颜色和深度图输出
        float T = 1.0f;
        half3 color = 0.0f;
        float depth = 0.0f;

        // 遍历 Tile 中保存的高斯数据
        // 每个 thread 负责一个像素，逐像素累计高斯数据

        bool done = false;
        for (int j = 0; !done && j < toDo; j++)
        {
            int coll_id = _RO_BinLeftPointListValue[range.x + j];
            // 根据像素到 2D 高斯中心点的距离，计算衰减度
            float2 xy = _RO_GeomData[coll_id].mean2D;


            float2 d = float2(xy.x - (float)global_id.x, xy.y - (float)global_id.y);

            float4 con_o = _RO_GeomData[coll_id].conic_opacity;
            float power = -0.5f * (con_o.x * d.x * d.x + con_o.z * d.y * d.y) + con_o.y * d.x * d.y;
            // if (power > 0.0f)
            //     continue;

            // 计算 alpha 透明度
            float alpha = min(0.99f, con_o.w * exp(power));
            // if (alpha < 1.0f / 255.0f)
            //     continue;

            float test_T = T * (1 - alpha);
            if (test_T < TEST_ALPHA)
            {
                done = true;
                continue;
            }

            // 累加颜色
            half3 tmp_color;
            tmp_color.r = f16tof32(_RO_GeomData[coll_id].rgb_depth.x >> 16);
            tmp_color.g = f16tof32(_RO_GeomData[coll_id].rgb_depth.x);
            tmp_color.b = f16tof32(_RO_GeomData[coll_id].rgb_depth.y >> 16);
            color += tmp_color * alpha * T;

            // 纪录截至时的最大深度
            depth = f16tof32(_RO_GeomData[coll_id].rgb_depth.y);;
            
            // 更新累积 alpha
            T = test_T;
        }

        // _GSRenderTexture[uint2(global_id.x, global_id.y)] = float4(group_id.xy, global_id.xy);
        
        _GSRenderTexture[uint2(global_id.x, H - global_id.y)] = float4(GammaToLinearSpace(color), 1.0 - T);
        _GSDepthTexture[uint2(global_id.x, H - global_id.y)] = depth;
    }
}
