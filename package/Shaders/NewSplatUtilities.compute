// radix sort etc. friendly, see http://stereopsis.com/radix.html
uint FloatToSortableUint(float f)
{
    uint fu = asuint(f);
    uint mask = -((int)(fu >> 31)) | 0x80000000;
    return fu ^ mask;
}

[numthreads(GROUP_SIZE,1,1)]
void CSSetIndices (uint3 id : SV_DispatchThreadID)
{
    uint idx = SwizzleDispatchThreadId(id);
    if (idx >= _SplatCount)
        return;

    _SplatSortKeys[idx] = idx;
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcDistances (uint3 id : SV_DispatchThreadID)
{
    uint idx = SwizzleDispatchThreadId(id);
    if (idx >= _SplatCount)
        return;

    uint origIdx = _SplatSortKeys[idx];

    float3 pos = LoadSplatPos(origIdx);
    // float3 pos = LoadSplatPosValue(origIdx);
    pos = mul(_MatrixMV, float4(pos.xyz, 1)).xyz;

    _SplatSortDistances[idx] = FloatToSortableUint(pos.z);
}

RWStructuredBuffer<SplatViewData> _SplatViewData;

float _SplatScale;
float _SplatOpacityScale;
uint _SHOrder;
uint _SHOnly;

uint _SplatCutoutsCount;

#define SPLAT_CUTOUT_TYPE_ELLIPSOID 0
#define SPLAT_CUTOUT_TYPE_BOX 1

struct GaussianCutoutShaderData // match GaussianCutout.ShaderData in C#
{
    float4x4 mat;
    uint typeAndFlags;
};
StructuredBuffer<GaussianCutoutShaderData> _SplatCutouts;

RWByteAddressBuffer _SplatSelectedBits;
ByteAddressBuffer _SplatDeletedBits;
uint _SplatBitsValid;

void DecomposeCovariance(float3 cov2d, out float2 v1, out float2 v2)
{
    #if 0 // does not quite give the correct results?

    // https://jsfiddle.net/mattrossman/ehxmtgw6/
    // References:
    // - https://www.youtube.com/watch?v=e50Bj7jn9IQ
    // - https://en.wikipedia.org/wiki/Eigenvalue_algorithm#2%C3%972_matrices
    // - https://people.math.harvard.edu/~knill/teaching/math21b2004/exhibits/2dmatrices/index.html
    float a = cov2d.x;
    float b = cov2d.y;
    float d = cov2d.z;
    float det = a * d - b * b; // matrix is symmetric, so "c" is same as "b"
    float trace = a + d;

    float mean = 0.5 * trace;
    float dist = sqrt(mean * mean - det);

    float lambda1 = mean + dist; // 1st eigenvalue
    float lambda2 = mean - dist; // 2nd eigenvalue

    if (b == 0) {
        // https://twitter.com/the_ross_man/status/1706342719776551360
        if (a > d) v1 = float2(1, 0);
        else v1 = float2(0, 1);
    } else
        v1 = normalize(float2(b, d - lambda2));

    v1.y = -v1.y;
    // The 2nd eigenvector is just a 90 degree rotation of the first since Gaussian axes are orthogonal
    v2 = float2(v1.y, -v1.x);

    // scaling components
    v1 *= sqrt(lambda1);
    v2 *= sqrt(lambda2);

    float radius = 1.5;
    v1 *= radius;
    v2 *= radius;

    #else

    // same as in antimatter15/splat
    float diag1 = cov2d.x, diag2 = cov2d.z, offDiag = cov2d.y;
    float mid = 0.5f * (diag1 + diag2);
    float radius = length(float2((diag1 - diag2) / 2.0, offDiag));
    float lambda1 = mid + radius;
    float lambda2 = max(mid - radius, 0.1);
    float2 diagVec = normalize(float2(offDiag, lambda1 - diag1));
    diagVec.y = -diagVec.y;
    float maxSize = 4096.0;
    v1 = min(sqrt(2.0 * lambda1), maxSize) * diagVec;
    v2 = min(sqrt(2.0 * lambda2), maxSize) * float2(diagVec.y, -diagVec.x);

    #endif
}

bool IsSplatCut(float3 pos)
{
    bool finalCut = false;
    for (uint i = 0; i < _SplatCutoutsCount; ++i)
    {
        GaussianCutoutShaderData cutData = _SplatCutouts[i];
        uint type = cutData.typeAndFlags & 0xFF;
        if (type == 0xFF) // invalid/null cutout, ignore
            continue;
        bool invert = (cutData.typeAndFlags & 0xFF00) != 0;

        float3 cutoutPos = mul(cutData.mat, float4(pos, 1)).xyz;
        if (type == SPLAT_CUTOUT_TYPE_ELLIPSOID)
        {
            if (dot(cutoutPos, cutoutPos) <= 1) return invert;
        }
        if (type == SPLAT_CUTOUT_TYPE_BOX)
        {
            if (all(abs(cutoutPos) <= 1)) return invert;
        }
        finalCut |= !invert;
    }
    return finalCut;
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcViewData (uint3 id : SV_DispatchThreadID)
{
    uint idx = SwizzleDispatchThreadId(id);
    if (idx >= _SplatCount)
        return;

    SplatData splat = LoadSplatData(idx);
    SplatViewData view = (SplatViewData)0;
    
    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos,1)).xyz;
    float4 centerClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    // deleted?
    if (_SplatBitsValid)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint wordVal = _SplatDeletedBits.Load(wordIdx * 4);
        if (wordVal & (1 << bitIdx))
        {
            centerClipPos.w = 0;
        }
    }

    view.pos = centerClipPos;
    bool behindCam = centerClipPos.w <= 0;
    if (!behindCam)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale;

        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        float3 cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, UNITY_MATRIX_P, _VecScreenParams);
        
        DecomposeCovariance(cov2d, view.axis1, view.axis2);

        float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
        float3 objViewDir = mul((float3x3)_MatrixWorldToObject, worldViewDir);
        objViewDir = normalize(objViewDir);

        half4 col;
        col.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);
        col.a = min(splat.opacity * opacityScale, 65000);
        
        view.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
        view.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);
    }
    
    _SplatViewData[idx] = view;
}

Texture2D<float> _GSPreDepthTexture;

[numthreads(GROUP_SIZE, 1, 1)]
void CSPreProcessViewData (uint3 id : SV_DispatchThreadID)
{
    uint idx = SwizzleDispatchThreadId(id);
    
    if (idx >= _SplatCount)
        return;
    _GeomData[idx] = (GeomData)0;
        
    float3 position = LoadSplatPosValue(idx);
    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(position,1)).xyz;
    float4 centerClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    // float4 centerViewPos = mul(UNITY_MATRIX_V, float4(centerWorldPos, 1));
    float4 preCenterClipPos = mul(_MatrixPreVP, float4(centerWorldPos, 1));
    // float4 preCenterClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    float2 preCenterNDCPos = preCenterClipPos.xy / preCenterClipPos.w;
    float2 preMean2d = ((preCenterNDCPos + 1.0f) * _VecScreenParams.xy - 1.0f) * 0.5f;
    
    // 视锥体剔除
    if (!InFrustum(centerClipPos)) return;

    // 深度剔除
    float preDepth = _GSPreDepthTexture.Load(int3(preMean2d.x, _VecScreenParams.y - preMean2d.y, 0));
    if (preDepth > 0.001 && centerClipPos.w - preDepth > 0.8) return;

    half4 color = LoadSplatColor(idx);
    // 透明度剔除
    if (color.a * 225.0f < 1.0f) return;
    
    // 解算 3D 高斯的协方差矩阵
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;
    
    float4 boxRot;
    float3 boxSize;
    LoadSplatRotAndScale(idx, boxRot, boxSize);
    float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);
    float3 cov3d0, cov3d1;
    CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
    float splatScale2 = splatScale * splatScale;
    cov3d0 *= splatScale2;
    cov3d1 *= splatScale2;
    
    // 通过 EWA 方法，投影 3D 高斯到平面上的 2D 高斯
    float3 cov2d;
    float3 worldViewDir;
    float3 conic2d;
    float width, height;
    float4x4 vm = mul(UNITY_MATRIX_V, _MatrixObjectToWorld);
    cov2d = CalcCovariance2D(position, cov3d0, cov3d1, vm, UNITY_MATRIX_P, _VecScreenParams);
    const float det_cov_plus_h_cov = cov2d.x * cov2d.z - cov2d.y * cov2d.y;
    const float det_cov = (cov2d.x - 0.3f) * (cov2d.z - 0.3f) - cov2d.y * cov2d.y;
    float h_convolution_scaling = sqrt(max(0.000025f, det_cov / det_cov_plus_h_cov));
    if (!DecomposeCovariance2DRadius(cov2d, color.a, width, height, conic2d)) return;
    
    worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos.xyz;
    
    
    // TODO: 这里可以增加一个参数，来剔除半径小于阈值的点
    if (width <= 0.0f || height <= 0.0f) return;
    
    // 计算该高斯球覆盖的屏幕 tile 范围
    float2 centerNDCPos = centerClipPos.xy / centerClipPos.w;
    float2 mean2d = ((centerNDCPos + 1.0f) * _VecScreenParams.xy - 1.0f) * 0.5f;
    float2 rect_min = {
        clamp((int)((mean2d.x - width)/_TileConfig.x), (int)0, (int)(_TileConfig.z)),
        clamp((int)((mean2d.y - height)/_TileConfig.y), (int)0, (int)(_TileConfig.w))
    };
    float2 rect_max = {
        clamp((int)((mean2d.x + width + _TileConfig.x - 1)/_TileConfig.x), (int)0, (int)(_TileConfig.z)),
        clamp((int)((mean2d.y + height + _TileConfig.y - 1)/_TileConfig.y), (int)0, (int)(_TileConfig.w))
    };
    if ((rect_max.x - rect_min.x) * (rect_max.y - rect_min.y) == 0)
        return;
    
    // 求解 SH 球谐函数，得到颜色数据
    float3 objViewDir = mul((float3x3)_MatrixWorldToObject, worldViewDir);
    objViewDir = normalize(objViewDir);
    SplatSHData sh = LoadSplatSH(idx);
    sh.col = color.rgb;
    float4 col;
    col.rgb = ShadeSH(sh, objViewDir, _SHOrder, _SHOnly != 0);
    col.a = min(color.a * opacityScale * h_convolution_scaling, 65000);

    // 采用原子加，来计算索引位置
    uint globalGemoIndex = idx;
    // uint globalGemoIndex;
    // InterlockedAdd(_NumArgs[0], 1, globalGemoIndex);
    
    // 记录数据
    // _GeomData[globalGemoIndex].touched_rects = int4(rect_min.x, rect_min.y, rect_max.x, rect_max.y);
    _GeomData[globalGemoIndex].conic_opacity = float4(conic2d.x, conic2d.y, conic2d.z, col.a);
    // _GeomData[globalGemoIndex].conic_opacity = float4(conic2d.x, conic2d.y, conic2d.z, preDepth);
    // _GeomData[globalGemoIndex].conic_opacity = centerClipPos;
    _GeomData[globalGemoIndex].rgb_depth.x = f32tof16(col.r) << 16 | f32tof16(col.g);
    _GeomData[globalGemoIndex].rgb_depth.y = f32tof16(col.b) << 16 | f32tof16(centerClipPos.w);
    _GeomData[globalGemoIndex].mean2D = mean2d;

    if (_NeedCalcBinPointList > 0)
    {
        for (int y = rect_min.y; y < rect_max.y; y++)
        {
            for (int x = rect_min.x; x < rect_max.x; x++)
            {
                float2 pix_min = { x * _TileConfig.x, y * _TileConfig.y };
                float2 pix_max = { pix_min.x + _TileConfig.x - 1, pix_min.y + _TileConfig.y - 1 };
                if (BlockContainsCenter(pix_min, pix_max, mean2d) ||
                    BlockIntersectEllipse(pix_min, pix_max, mean2d, float4(conic2d.x, conic2d.y, conic2d.z, col.a)))
                {
                    uint globalBinPointIndex;
                    InterlockedAdd(_NumArgs[1], 1, globalBinPointIndex);
                
                    uint depth = FloatToUint(centerClipPos.w);
                    uint64_t tile_key = y * (uint)_TileConfig.z + x;
                    tile_key <<= 32;
                    _BinPointListKey[globalBinPointIndex] = tile_key | ((uint64_t)depth & (((uint64_t)1U << 32) - 1));;
                    _BinPointListValue[globalBinPointIndex] = globalGemoIndex;
                }
            }
        }
    }
}

[numthreads(GROUP_SIZE, 1, 1)]
void CSIdentifyTileRanges (uint3 global_id : SV_DispatchThreadID)
{
    uint idx = SwizzleDispatchThreadId(global_id);
    if (idx >= _NumArgs[1]) return;

    uint64_t currkey = _RO_BinPointListKey[idx];
    uint currtile = currkey >> 32;
    if (idx == 0)
    {
        _ImageRange[currtile].x = 0;
    }
    else
    {
        uint64_t prevkey = _RO_BinPointListKey[idx - 1];
        uint prevtile = prevkey >> 32;
        if (currtile != prevtile)
        {
            _ImageRange[prevtile].y = idx;
            _ImageRange[currtile].x = idx;
        }
    }

    if (idx == _NumArgs[1] - 1)
    {
        _ImageRange[currtile].y = _NumArgs[1];
    }
}

[numthreads(GROUP_SIZE, 1, 1)]
void CSInitImageRanges (uint3 global_id : SV_DispatchThreadID)
{
    uint idx = SwizzleDispatchThreadId(global_id);

    if (idx >= _NumArgs[1]) return;
    _ImageRange[idx] = (uint2)0;
}


[numthreads(1, 1, 1)]
void CSInitNumArgs (uint3 global_id : SV_DispatchThreadID)
{
    _NumArgs[0] = 0;

    if (_NeedCalcBinPointList > 0)
    {
        _NumArgs[1] = 0;
        _NumArgs[2] = 1;
        _NumArgs[3] = 1;
        _NumArgs[4] = 1;
        _NumArgs[5] = 1;
        _NumArgs[6] = 1;
        _NumArgs[7] = 1;
    }
}

[numthreads(1, 1, 1)]
void CSInitSortArgs (uint3 global_id : SV_DispatchThreadID)
{
    uint count = clamp(_NumArgs[1], e_min, e_max);
    
    _NumArgs[1] = count;
    _NumArgs[2] = (count + PART_SIZE - 1) / PART_SIZE;
    _NumArgs[3] = 1;
    _NumArgs[4] = 1;
    
    int limitX = GROUP_SIZE * MAX_DISPATCH_GROUP;
    if (count > limitX)
    {
        _NumArgs[5] = MAX_DISPATCH_GROUP;
        _NumArgs[6] = count / limitX + 1;
    }
    else
    {
        _NumArgs[5] = (count  + GROUP_SIZE - 1) / GROUP_SIZE;
        _NumArgs[6] = 1;
    }

    _NumArgs[7] = 1;
}

